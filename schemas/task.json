{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["id", "status", "risk", "version", "paths", "symbols", "tags", "skills", "expected_write_scope", "required_capabilities", "required_evidence", "acceptance_criteria", "dod"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
    "status": { "enum": ["draft", "approved", "blocked", "done"] },
    "risk": { "enum": ["low", "medium", "high"] },
    "version": { "type": "integer", "minimum": 1 },
    "discovery": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "outcome", "sources", "flow", "decisions", "open_questions"],
      "properties": {
        "status": { "enum": ["pending", "ready"] },
        "outcome": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["kind", "reference", "summary"],
          "properties": { "kind": { "enum": ["conversation", "plan", "source", "reference"] }, "reference": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 } }
        } },
        "flow": { "type": "string", "minLength": 1 },
        "decisions": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["decision", "basis", "reference"],
          "properties": { "decision": { "type": "string", "minLength": 1 }, "basis": { "enum": ["user", "source", "agent"] }, "reference": { "type": "string", "minLength": 1 } }
        } },
        "open_questions": { "$ref": "#/definitions/strings" }
      }
    },
    "paths": { "$ref": "#/definitions/strings" },
    "symbols": { "$ref": "#/definitions/strings" },
    "tags": { "$ref": "#/definitions/strings" },
    "skills": { "$ref": "#/definitions/strings" },
    "expected_write_scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "required_capabilities": { "$ref": "#/definitions/strings" },
    "required_evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["E1", "E2", "E3", "E4", "E5"] }, "contains": { "const": "E4" } },
    "acceptance_criteria": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "description"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } } }
    },
    "dod": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "criterion", "evidence", "acceptance"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "criterion": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["E1", "E2", "E3", "E4", "E5"] } },
          "acceptance": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "approval": {
      "type": "object", "required": ["by", "at", "contract_sha256"], "additionalProperties": false,
      "properties": { "by": { "type": "string", "minLength": 1 }, "at": { "type": "string", "minLength": 1 }, "contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    }
  },
  "definitions": { "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
}
